#!/usr/bin/env bash
# .githooks/pre-commit -- 提交前 gofmt 闸（2026-10-24，**本文件受版本控制**）
#
# 为什么需要（本人已在 CI 上因「改完 .go 忘跑 gofmt」多跑三轮：round 14 / 22 / 23）：
#   人在三次教训后仍会忘，所以把检查挪到提交前 —— 失败就在本地，不用等 CI 五分钟。
#
# 为什么用 .githooks/ 而不是 .git/hooks/（本仓在册教训的再一次应验）：
#   `.git/hooks` 不受版本控制（「非跟踪、git 还原不了」）—— 判据会随 clone 丢失；
#   且首版用 `#!/bin/sh` 在这台 Windows 机上**静默失效**（PATH 无 sh，
#   git 报 cannot spawn 却放过提交）。故用 `#!/usr/bin/env bash`（git 自带 bash 可用）。
#
# 三个实现坑（2026-10-24 全部实测定位，不是猜的）：
#   1) hook 里也要自己找 git：本 hook 由 git spawn，其 PATH 里没有 git 可执行文件；
#   2) **必须 cd 到仓库根再转调 PowerShell**：git 传给 hook 的 GIT_INDEX_FILE 是
#      **相对路径** `.git/index`，而 PowerShell 进程的 cwd 是 system32 ——
#      不 cd 的话 gate 里 `git diff --cached` 读到空暂存区，判据恒「通过」（假绿）；
#   3) hook 名必须无扩展名（只有 pre-commit.cmd 时 git 找不到入口）。
#
# 启用方式（一次性，写入 .git/config）：git config core.hooksPath .githooks
#
# 判据逻辑不在本文件里：真正的判据在 tests/check_staged_gofmt.ps1（同样受版本控制），
# 可被 CI / 干净 clone / 他人机器复用。

set -u

GIT_EXE=$(command -v git || echo '/c/Program Files/Git/cmd/git.exe')
if [ ! -x "$GIT_EXE" ]; then
  echo "pre-commit: 找不到 git 可执行文件，跳过 gofmt 闸" >&2
  exit 0
fi

repo_root=$("$GIT_EXE" rev-parse --show-toplevel 2>/dev/null) || exit 0
# 坑 2：cd 到仓库根，让 PowerShell 侧能解析相对的 GIT_INDEX_FILE
cd "$repo_root" || exit 0

gate="$repo_root/tests/check_staged_gofmt.ps1"
if [ ! -f "$gate" ]; then
  # 判据脚本缺失时**不阻断**（避免 hook 挡住提交却给不出原因），但明确告警
  echo "pre-commit: 找不到 $gate —— 跳过 gofmt 闸（判据应受版本控制，请检查）" >&2
  exit 0
fi

# 优先 pwsh（PS7），退回 powershell.exe（PS5.1，CI 同款）
if command -v pwsh >/dev/null 2>&1; then
  ps=pwsh
else
  ps=powershell.exe
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File "$gate"
rc=$?
if [ $rc -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: 暂存的 .go 未 gofmt，提交已拦截。" >&2
  echo "修复: cd workbench && gofmt -w <上面列出的文件> && git add <它们>" >&2
  echo "（紧急跳过: git commit --no-verify，但 CI 会判红，代价更大）" >&2
  exit 1
fi

# ---- 第二道闸：暂存区 BOM（round 95 加）----
# 为什么判索引而不是等工作区：check_multi_bom / check_ps1_encoding 判 HEAD 口径，
# 文件没 commit 就不在 HEAD 里 —— round 95 实测：本地 check_all 33 PASS 而 CI 红，
# 差的正是这段窗口。判索引能在入库前那一刻拦住。
gate2="$repo_root/tests/check_staged_bom.ps1"
if [ ! -f "$gate2" ]; then
  echo "pre-commit: 找不到 $gate2 —— 跳过 BOM 闸" >&2
  exit 0
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File "$gate2"
rc2=$?
if [ $rc2 -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: 即将入库的文件有 BOM 缺陷，提交已拦截。" >&2
  echo "修复: 剥净多重 BOM（.ps1/.psm1 含非 ASCII 需恰好 1 个；.go 必须 0 个）后 git add" >&2
  echo "（紧急跳过: git commit --no-verify，但 CI 的 check_multi_bom 会判红，代价更大）" >&2
  exit 1
fi

# ---- 第三道闸：报告规模数字与仓库实况一致（2026-11-01 round 189 加）----
# 为什么放在提交前而不是只靠 CI/聚合（本仓 round 95 同一立场：判索引能在入库前那一刻拦住）：
#   figures 判据本轮连着抓到我 3 次漂移，但每次都是「提交之后」才红 —— 因为缺陷是**提交顺序**造成的：
#   先提交代码（新增受跟踪 .go ⇒ 文件数/行数/测试数都变）、后补报告数字，中间那段窗口里任何
#   跑聚合的人都会红，而红因归属于上一笔。提交前跑一次就把这个窗口关掉。
# 为什么这里判得准：check_report_figures 的计数走 git ls-files（**索引**口径，含刚 add 的新 .go），
#   报告走工作区文件 ⇒ 「代码进暂存区、报告没跟着改」当场不一致，正是我们要拦的那一种。
# 已知残留窗口（如实写，不假装全堵）：若有人改了报告却**没 git add 报告**，本闸读工作区会放行，
#   入库的报告仍是旧值。那一档要靠聚合/CI 兜；本闸负责最高频的那一类（忘了改报告）。
# 耗时实测 1.6s（相对 gofmt/BOM 两道毫秒级闸更慢，但换掉的是「下一轮才发现」的成本）。
gate3="$repo_root/tests/check_report_figures.ps1"
if [ ! -f "$gate3" ]; then
  echo "pre-commit: 找不到 $gate3 —— 跳过报告数字闸" >&2
  exit 0
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File "$gate3" -Quiet
rc3=$?
# 三态口径（与聚合门禁一致，round 190 自查修掉的误拦）：只有 rc=1 才是「数字确实不符」；
# rc=2 是 UNVERIFIED（例如 hook 子进程里解析不到 git、或仓库根不存在），拦住提交等于把
# 「我没测成」当成「你写错了」—— 那会让人开始绕 hook（本仓在册：门禁一误拦就被绕过）。
if [ $rc3 -eq 2 ]; then
  echo "pre-commit: 报告数字闸未能判定（UNVERIFIED），本次放行；本地聚合 check_all 仍会复查。" >&2
elif [ $rc3 -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: 报告规模数字与仓库实况不符（本次提交改了受跟踪 .go 的数量，报告数字没跟着改）。" >&2
  echo "修复: 跑 powershell -File tests\check_report_figures.ps1 看差在哪，把报告里的数字改成实测值，" >&2
  echo "      与代码**同一批** git add 后再提交。" >&2
  echo "（紧急跳过: git commit --no-verify，但本地聚合 check_all 的「报告数字一致性」会判红）" >&2
  exit 1
fi

exit 0