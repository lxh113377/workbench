@@ handlePoolModelItem: 模型 ID 本身带斜杠，不能按第一段切
-	parts := strings.Split(rest, "/")
-	id, err := url.PathUnescape(parts[0])
-	if err != nil {
-		bad(w, "模型 ID 非法")
